# Local app URL. Keep this aligned with package.json's dev script.
NEXT_PUBLIC_APP_URL=http://localhost:3032
APP_URL=http://localhost:3032

# Local Supabase values printed by `npm run supabase:status` after `npm run supabase:start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional local defaults.
NEXT_PUBLIC_SUPABASE_BUCKET_NAME=uploads
NEXT_PUBLIC_EMAIL_FROM=
NEXT_PUBLIC_RESEND_API_KEY=
CRON_SECRET=

# Zoho FSM web-app URL. When set, the scheduling entry-detail dialog turns the
# Work Order / Appointment ids into deep links into FSM. Leave blank to render
# them as plain text. NOTE: this is a NEXT_PUBLIC_ var, so after changing it you
# must restart `next dev` (or rebuild) for it to take effect.
#
# Best: paste a template with {id} (and optionally {module}) matching a real
# record URL from your tenant — open any appointment in FSM and copy its URL,
# then replace the record id with {id}. {module} resolves to Work_Orders or
# Service_Appointments.
#
# IMPORTANT: FSM URLs contain a '#', which .env treats as a comment (everything
# after it is dropped) UNLESS the value is wrapped in double quotes. Always
# quote it. Examples:
#   NEXT_PUBLIC_FSM_APP_URL="https://fsm.zoho.com/fsm/<orgId>#/tab/{module}/{id}"
#   NEXT_PUBLIC_FSM_APP_URL="https://fsm.zoho.com/<orgId>/index.do#{module}/{id}"
# Or a plain base (record appended as <base>#<module>/<id>):
#   NEXT_PUBLIC_FSM_APP_URL="https://fsm.zoho.com/<orgId>/index.do"
NEXT_PUBLIC_FSM_APP_URL=

# Google Maps browser key (Maps JavaScript, Embed and Geocoding APIs). Restrict it to the portal domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Snagging quotations into Zoho FSM (contacts, estimates, their status). Off unless "on".
SNAGGING_FSM_SYNC=off

# Finance: a line or work order marked complete in the portal is completed in Zoho FSM too
# (started appointments only; the work order's own Complete for the whole work order). Off unless "on".
FINANCE_FSM_COMPLETION=off

# Reports module (Reports, My compliance, Settings -> Reporting). Hidden unless "on".
# NEXT_PUBLIC: fixed at build time, so restart `next dev` or rebuild after changing it.
NEXT_PUBLIC_REPORTS_ENABLED=off

# Finance: reading MAHER invoices uploaded on Finance -> Ready to invoice (Claude). Without the key,
# the upload says scanning is not set up and invoices are recorded by hand.
ANTHROPIC_API_KEY=
# Optional; Claude Haiku 5.5 (light and fast) by default.
ANTHROPIC_INVOICE_MODEL=claude-haiku-5-5
