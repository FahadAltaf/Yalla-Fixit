# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# local Supabase state and data dumps
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/**/prod-data*.sql
supabase/**/production*.sql
supabase/**/backup*.sql
supabase/**/dump*.sql
supabase/**/data.local.sql
*.local.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
